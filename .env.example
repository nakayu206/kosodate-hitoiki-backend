# ローカル開発用の環境変数の例。実際の値は書かず、変数名と用途だけを管理する。
# 値は `npx supabase start` の出力、または各サービスのダッシュボードから取得する。

# Supabaseローカルスタック（`npx supabase start` の出力に表示される）
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 送信前チェック（誹謗中傷チェック）で使用するOpenAI Moderation API
OPENAI_API_KEY=

# dev・prodのSupabaseプロジェクトの情報はこのファイルに書かない。
# 接続情報はGitHub Environments（development / production）のSecrets・Variablesでのみ管理し、
# ローカルの.envやリポジトリには保存しない（docs/開発・運用方針.md参照）。
